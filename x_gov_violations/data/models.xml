    <record id="field_x_gov_violation__x_division" model="ir.model.fields">
        <field name="model_id" ref="model_x_gov_violation"/>
        <field name="name">x_division</field>
        <field name="field_description">القسم</field>
        <field name="ttype">selection</field>
        <field name="selection">[('ew','سيدات (EW)'),('em','رجال (EM)'),('hotels','الفنادق'),('unalloc','غير مرتبط بفرع')]</field>
        <field name="index" eval="True"/>
        <field name="depends">x_branch_id,x_company_id</field>
        <field name="compute"><![CDATA[for record in self:
    branch = (record.x_branch_id.name or '').strip().upper()
    if branch.startswith('EW'):
        value = 'ew'
    elif branch.startswith('EM'):
        value = 'em'
    elif 'sustainable' in (record.x_company_id.name or '').lower():
        value = 'hotels'
    else:
        value = 'unalloc'
    record['x_division'] = value]]></field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
    </record>
    <record id="field_x_gov_violation__x_objection_state" model="ir.model.fields">
