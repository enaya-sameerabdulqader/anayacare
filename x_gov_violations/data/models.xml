        <field name="field_description">نافذة الاعتراض</field>
        <field name="ttype">selection</field>
        <field name="selection">[('open','مفتوحة للاعتراض'),('filed','تم الاعتراض'),('expired','انتهت المهلة'),('not_allowed','الاعتراض غير مسموح')]</field>
        <field name="index" eval="True"/>
        <field name="depends">x_objection_allowed,x_objection_filed,x_objection_deadline,x_refresh_stamp</field>
        <field name="compute"><![CDATA[today = datetime.date.today()
for record in self:
    if not record.x_objection_allowed:
        value = 'not_allowed'
    elif record.x_objection_filed:
        value = 'filed'
    elif not record.x_objection_deadline or record.x_objection_deadline >= today:
        value = 'open'
    else:
        value = 'expired'
    record['x_objection_state'] = value]]></field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
    </record>
    <record id="field_x_gov_violation__x_days_left" model="ir.model.fields">
        <field name="model_id" ref="model_x_gov_violation"/>
        <field name="name">x_days_left</field>
        <field name="field_description">الأيام المتبقية</field>
        <field name="ttype">integer</field>
        <field name="depends">x_objection_deadline,x_objection_state</field>
        <field name="compute"><![CDATA[today = datetime.date.today()
for record in self:
    if record.x_objection_state == 'open' and record.x_objection_deadline:
        record['x_days_left'] = (record.x_objection_deadline - today).days
    else:
        record['x_days_left'] = 0]]></field>
        <field name="store" eval="False"/>
        <field name="readonly" eval="True"/>
    </record>
    <record id="field_x_gov_violation__x_open_exposure" model="ir.model.fields">
        <field name="model_id" ref="model_x_gov_violation"/>
        <field name="name">x_open_exposure</field>
        <field name="field_description">المبلغ المستحق</field>
        <field name="ttype">float</field>
        <field name="depends">x_amount,x_status,x_suspected_duplicate,x_in_register</field>
        <field name="compute"><![CDATA[for record in self:
    if record.x_status == 'unpaid' and not record.x_suspected_duplicate and record.x_in_register:
        record['x_open_exposure'] = record.x_amount
    else:
        record['x_open_exposure'] = 0.0]]></field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
    </record>
    <record id="field_x_gov_violation__x_date_warning" model="ir.model.fields">
        <field name="model_id" ref="model_x_gov_violation"/>
        <field name="name">x_date_warning</field>
        <field name="field_description">تحذير تاريخ</field>
        <field name="ttype">boolean</field>
        <field name="depends">x_violation_date,x_objection_deadline,x_refresh_stamp</field>
        <field name="compute"><![CDATA[today = datetime.date.today()
for record in self:
    day = record.x_violation_date
    deadline = record.x_objection_deadline
    record['x_date_warning'] = bool(day and (day > today or (deadline and deadline < day)))]]></field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
    </record>
