<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Two access levels: User (مستخدم) and Manager (مدير, implies User). -->
    <record id="privilege_gov_violation" model="res.groups.privilege">
        <field name="name">المخالفات الحكومية</field>
        <field name="sequence">100</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_gov_violation_user" model="res.groups">
        <field name="name">مستخدم</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_gov_violation"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_gov_violation_manager" model="res.groups">
        <field name="name">مدير</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_gov_violation"/>
        <field name="implied_ids" eval="[Command.link(ref('group_gov_violation_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company (global rules: apply to everyone) -->
    <record id="rule_gov_violation_company" model="ir.rule">
        <field name="name">المخالفات الحكومية: الشركات المسموحة</field>
        <field name="model_id" ref="model_gov_violation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_gov_license_map_company" model="ir.rule">
        <field name="name">ربط التراخيص: الشركات المسموحة</field>
        <field name="model_id" ref="model_gov_license_map"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
