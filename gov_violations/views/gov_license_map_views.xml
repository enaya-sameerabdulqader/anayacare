<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="gov_license_map_view_list" model="ir.ui.view">
        <field name="name">gov.license.map.list</field>
        <field name="model">gov.license.map</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-warning="not is_mapped">
                <field name="name"/>
                <field name="company_id" options="{'no_create': True}"/>
                <field name="branch_plan_id" column_invisible="True"/>
                <field name="branch_id" options="{'no_create': True}"/>
                <field name="facility_name"/>
                <field name="inferred"/>
                <field name="note" optional="show"/>
                <field name="is_mapped" optional="hide"/>
                <field name="violation_count"/>
                <button name="action_view_violations" type="object" string="المخالفات"
                        icon="fa-list" class="btn-link"/>
                <button name="action_apply_to_violations" type="object" string="تطبيق على المخالفات"
                        icon="fa-refresh" class="btn-link" invisible="not is_mapped"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="gov_license_map_view_search" model="ir.ui.view">
        <field name="name">gov.license.map.search</field>
        <field name="model">gov.license.map</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="facility_name"/>
                <field name="branch_id"/>
                <filter name="unmapped" string="غير مربوط بفرع" domain="[('is_mapped', '=', False)]"/>
                <filter name="inferred" string="ربط استنتاجي" domain="[('inferred', '=', True)]"/>
                <separator/>
                <filter name="archived" string="مؤرشف" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="الشركة" context="{'group_by': 'company_id'}"/>
                    <filter name="group_branch" string="الفرع" context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_gov_license_map" model="ir.actions.act_window">
        <field name="name">ربط التراخيص بالفروع</field>
        <field name="res_model">gov.license.map</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="gov_license_map_view_search"/>
    </record>
</odoo>
