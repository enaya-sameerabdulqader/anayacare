<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_gov_violation_daily" model="ir.cron">
        <field name="name">المخالفات الحكومية: تحديث نوافذ الاعتراض والتذكيرات</field>
        <field name="model_id" ref="model_gov_violation"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:30:00')"/>
        <field name="priority">5</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
